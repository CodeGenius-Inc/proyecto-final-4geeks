# Ejemplo de variables de entorno para FuelFlow Backend
# Copia este archivo como .env y completa con tus valores reales

# Configuración de Base de Datos
DB_HOST=tu-host-neon.aws.neon.tech
DB_PORT=5432
DB_NAME=fuel_flow
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Clave secreta para sesiones (genera una segura en producción)
SECRET_KEY=cambia-esto-por-una-clave-segura-random

# CORS - URLs permitidas (separadas por coma)
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

# Puerto (opcional, Render lo asigna automáticamente)
PORT=5000
